# Public DNS name whose A/AAAA record points to this server.
SUPPLIER_NODE_PUBLIC_HOST=node.example.com

# Generate with: corepack pnpm@9.15.0 --filter @token-streaming/supplier-node build
# Then: node apps/supplier-node/dist/index.js token
SUPPLIER_NODE_GATEWAY_TOKEN=replace-with-a-generated-256-bit-token

# Authorized upstream project/account. Never commit this value.
SUPPLIER_NODE_UPSTREAM_API_KEY=replace-with-an-authorized-provider-key
SUPPLIER_NODE_PROVIDER_ID=replace-with-provider-id
SUPPLIER_NODE_UPSTREAM_PROTOCOL=responses
SUPPLIER_NODE_UPSTREAM_BASE_URL=https://api.provider.example/v1
SUPPLIER_NODE_UPSTREAM_HOST_ALLOWLIST=api.provider.example

# Exact model names and bounded capacity approved for this node.
SUPPLIER_NODE_ALLOWED_MODELS=replace-with-exact-model-name
SUPPLIER_NODE_ALLOWED_DATA_CLASSES=P0
SUPPLIER_NODE_REQUESTS_PER_MINUTE=30
SUPPLIER_NODE_TOKENS_PER_MINUTE=100000
SUPPLIER_NODE_CONCURRENCY=2
SUPPLIER_NODE_MAX_OUTPUT_TOKENS=4096
SUPPLIER_NODE_MAX_INPUT_BYTES=65536
SUPPLIER_NODE_UPSTREAM_TIMEOUT_MS=60000
SUPPLIER_NODE_MAXIMUM_UPSTREAM_RESPONSE_BYTES=1000000
