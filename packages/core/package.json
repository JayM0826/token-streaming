{
  "name": "@token-streaming/core",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@token-streaming/ai-manifest": "workspace:*",
    "@token-streaming/protocol": "workspace:*",
    "@token-streaming/providers": "workspace:*",
    "@token-streaming/storage": "workspace:*",
    "@token-streaming/tools": "workspace:*"
  }
}
